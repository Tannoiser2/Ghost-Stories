 "artefatti": {
  "pozione": {
   "nome": "Pozione della Vita",
   "desc": "Nella fase Yang: scartala e un Taoista guadagna 1 Qi (un morto torna in vita con 1 Qi sul Cimitero, senza dado), oppure un villico ucciso torna sul Cimitero."
  },
  "polvere": {
   "nome": "Polvere di Luna",
   "desc": "Nella fase Yang: scartala e prendi un Cristallo di Luna."
  },
  "pergamena": {
   "nome": "Pergamena dell'Unità",
   "desc": "Dopo il movimento: scartala e tutti gli altri Taoisti vivi vengono sulla tua tessera (in solitario: prendi i segnalini potere del centro)."
  },
  "fuoco": {
   "nome": "Fuoco d'Artificio",
   "desc": "Nella fase Yang: scartalo e ottieni l'aiuto di un'altra tessera senza andarci."
  },
