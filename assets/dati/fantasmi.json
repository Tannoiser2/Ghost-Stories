  },
  "erborista": {
   "nome": "Bottega dell'Erborista",
   "originale": "Herbalist's Shop",
   "aiuto": "Tira 2 dadi Tao e prendi i segnalini dei colori usciti (bianco: colore a scelta)."
  },
  "padiglione": {
   "nome": "Padiglione dei Venti Celesti",
   "originale": "Pavilion of the Heavenly Winds",
   "aiuto": "Sposta un fantasma su uno spazio libero qualunque (anche con un Buddha), poi sposta un altro Taoista su una tessera qualunque."
  },
  "altare": {
   "nome": "Altare Taoista",
   "originale": "Taoist Altar",
