  },
  "stregone": {
   "nome": "Capanna dello Stregone",
   "originale": "Sorcerer's Hut",
   "aiuto": "Manda all'inferno un fantasma qualunque (non un'incarnazione), senza effetti né ricompense. Perdi 1 Qi."
  },
  "cimitero": {
   "nome": "Cimitero",
   "originale": "Cemetery",
   "aiuto": "Riporta in vita un Taoista morto con 2 Qi (oppure, con White Moon, un villico ucciso) sul Cimitero, poi tira il dado della maledizione."
  },
  "guardiano": {
   "nome": "Ronda del Guardiano Notturno",
   "originale": "Night Watchman's Beat",
   "aiuto": "Tutte le figurine infestanti di una plancia a scelta tornano indietro di un passo, sulla carta."
  },
  "kungfu": {
   "nome": "Scuola di Kung-Fu",
   "originale": "Kung-Fu School",
   "aiuto": "Esorcismo solitario contro TUTTI i fantasmi del colore della tua plancia oppure contro TUTTI i fantasmi neri (non le incarnazioni). Solo dadi, i tuoi Tao e i tuoi cristalli; nessuna ricompensa né maledizione."
  }
 },
