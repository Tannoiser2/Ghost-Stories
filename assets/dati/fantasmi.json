 "villaggio": {
  "casa_te": {
   "nome": "Casa del Tè",
   "originale": "Tea House",
   "aiuto": "Prendi un segnalino Tao del colore che vuoi e guadagni 1 Qi, poi entra in gioco un fantasma."
  },
  "erborista": {
   "nome": "Bottega dell'Erborista",
   "originale": "Herbalist's Shop",
   "aiuto": "Tira 2 dadi Tao e prendi i segnalini dei colori usciti (bianco: colore a scelta)."
  },
  "padiglione": {
   "nome": "Padiglione dei Venti Celesti",
   "originale": "Pavilion of the Heavenly Winds",
   "aiuto": "Sposta un fantasma su uno spazio libero qualunque (anche con un Buddha), poi sposta un altro Taoista su una tessera qualunque."
  },
  "altare": {
   "nome": "Altare Taoista",
   "originale": "Taoist Altar",
   "aiuto": "Libera una tessera infestata girandola sul lato attivo, poi entra in gioco un fantasma."
  },
  "tempio": {
   "nome": "Tempio Buddista",
   "originale": "Buddhist Temple",
   "aiuto": "Prendi un Buddha: in un turno successivo lo metterai su uno spazio libero di fronte a te."
  },
  "cerchio": {
   "nome": "Cerchio di Preghiera",
   "originale": "Circle of Prayer",
   "aiuto": "Metti (o cambia) qui un segnalino Tao: tutti i fantasmi di quel colore hanno 1 di resistenza in meno."
  },
  "stregone": {
   "nome": "Capanna dello Stregone",
   "originale": "Sorcerer's Hut",
   "aiuto": "Manda all'inferno un fantasma qualunque (non un'incarnazione), senza effetti né ricompense. Perdi 1 Qi."
  },
  "cimitero": {
   "nome": "Cimitero",
   "originale": "Cemetery",
   "aiuto": "Riporta in vita un Taoista morto con 2 Qi (oppure, con White Moon, un villico ucciso) sul Cimitero, poi tira il dado della maledizione."
  },
  "guardiano": {
   "nome": "Ronda del Guardiano Notturno",
   "originale": "Night Watchman's Beat",
   "aiuto": "Tutte le figurine infestanti di una plancia a scelta tornano indietro di un passo, sulla carta."
  },
  "kungfu": {
   "nome": "Scuola di Kung-Fu",
   "originale": "Kung-Fu School",
   "aiuto": "Esorcismo solitario contro TUTTI i fantasmi del colore della tua plancia oppure contro TUTTI i fantasmi neri (non le incarnazioni). Solo dadi, i tuoi Tao e i tuoi cristalli; nessuna ricompensa né maledizione."
  },
  "calligrafo": {
   "nome": "Calligrafo",
   "originale": "Calligrapher",
   "aiuto": "Cambia un Mantra di Sangue con un altro dello stesso livello (il Qi sopra torna nella riserva) e/o metti 1 Qi della riserva su un Mantra di Sangue."
  }
 },
