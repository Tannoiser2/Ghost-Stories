 "artefatti": {
  "pozione": {
   "nome": "Pozione della Vita",
   "desc": "Nella fase Yang: scartala e un Taoista guadagna 1 Qi (un morto torna in vita con 1 Qi sul Cimitero, senza dado), oppure un villico ucciso torna sul Cimitero."
  },
  "polvere": {
   "nome": "Polvere di Luna",
   "desc": "Nella fase Yang: scartala e prendi un Cristallo di Luna."
  },
  "pergamena": {
   "nome": "Pergamena dell'Unità",
   "desc": "Dopo il movimento: scartala e tutti gli altri Taoisti vivi vengono sulla tua tessera (in solitario: prendi i segnalini potere del centro)."
  },
  "fuoco": {
   "nome": "Fuoco d'Artificio",
   "desc": "Nella fase Yang: scartalo e ottieni l'aiuto di un'altra tessera senza andarci."
  },
  "artiglio": {
   "nome": "Artiglio Vendicativo",
   "desc": "Dopo un esorcismo fallito del tutto prendi un Tao del colore di un fantasma attaccato (una volta per turno)."
  },
  "armatura": {
   "nome": "Armatura del Giusto",
   "desc": "Ignori le abilità d'arrivo (pietra sinistra) dei fantasmi che entrano sulla tua plancia (non delle incarnazioni)."
  },
  "scudo": {
   "nome": "Scudo del Tempo",
   "desc": "Quando nel tuo turno peschi un fantasma del colore della tua plancia, va in fondo al mazzo e ne peschi un altro (non con le incarnazioni)."
  },
  "spada": {
   "nome": "Spada Divina",
   "desc": "In ogni tuo esorcismo un dado Tao è già sul bianco: tiri solo gli altri."
  }
 },
